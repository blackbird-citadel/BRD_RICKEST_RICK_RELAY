<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS Permissions -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Multi-SIM Support Permission -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Foreground Service Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/rick_icon"
        android:roundIcon="@drawable/rick_icon"
        android:label="Rickest Rick Relay"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Initial Branch Login Screen -->
        <activity
            android:name="com.brd.relay.ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard -->
        <activity
            android:name="com.brd.relay.ui.MainActivity"
            android:exported="false" />

        <!-- Foreground SMS Forwarding Service -->
        <service
            android:name="com.brd.relay.services.RelayForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- High-Priority SMS Interceptor Receiver -->
        <receiver
            android:name="com.brd.relay.receivers.SmsInterceptReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>