<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header / Branch Title -->
        <TextView
            android:id="@+id/tvBusinessName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Branch"
            android:textColor="#66FCF1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Metrics Section: Daily & Monthly Sales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1F2833"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Sales"
                    android:textColor="#C5C6C7"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDailySales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ksh 0.00"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSalesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Transactions"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1F2833"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Total"
                    android:textColor="#C5C6C7"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMonthlySales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ksh 0.00"
                    android:textColor="#66FCF1"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Relay Toggle Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1F2833"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable SMS Relay"
                android:textColor="#C5C6C7"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchRelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textOn=""
                android:textOff=""
                app:showText="false" />
        </LinearLayout>

        <!-- SMS Balance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1F2833"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvSmsBalance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="100 SMS remaining"
                android:textColor="#059669"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBuySms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy SMS"
                android:backgroundTint="#45A29E" />
        </LinearLayout>

        <!-- Employee Enrollment Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enroll Employee"
            android:textColor="#45A29E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEmployeeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Employee Name (e.g., Mary)"
            android:textColor="#C5C6C7"
            android:textColorHint="#6B7280"
            android:background="#1F2833"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etWorkerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number (e.g., 0712345678)"
            android:inputType="phone"
            android:textColor="#C5C6C7"
            android:textColorHint="#6B7280"
            android:background="#1F2833"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEnroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enroll Worker"
            android:backgroundTint="#66FCF1"
            android:textColor="#0B0C10"
            android:layout_marginBottom="16dp" />

        <!-- Enrolled Employees Container -->
        <LinearLayout
            android:id="@+id/llEmployeeListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvRickMotto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLICK IF YOUR BRAVE ENOUGH AM THE RICKEST RICK !!!!, Wubba Lubba Dub Dub!"
            android:textColor="#45A29E"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>